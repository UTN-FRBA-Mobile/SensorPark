rules_version = '2';

// Firestore deniega todo lo que no tenga un `allow` explícito: colección nueva = regla nueva.
// Las reglas no son filtros: la query del cliente tiene que llevar el mismo `where` que la regla exige.
// Las Cloud Functions usan el Admin SDK y no pasan por estas reglas: lo que acá no tiene `allow`
// de escritura (reservas, lista de espera, contadores) lo escriben sólo ellas.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // El rol es un custom claim que sólo asigna el backend (functions/index.js).
    function hasRole(role) { return isSignedIn() && request.auth.token.get('role', '') == role; }
    function isAdmin() { return hasRole('ADMIN'); }

    // get() porque se evalúa también desde subcolecciones y desde reservas, donde `resource` es otro documento.
    function managesParkingLot(lotId) {
      return hasRole('PARKING_ADMIN') &&
        request.auth.uid in get(/databases/$(database)/documents/parkingLots/$(lotId)).data.adminUids;
    }

    // Contadores de lugares del estacionamiento: los calcula la function updateFreeSpotCounters.
    function counterFields() {
      return ['capacity', 'freeSpots', 'capacityByType', 'freeSpotsByType'];
    }

    function changes(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // La categoría de prioridad es de buena fe: la declara el propio usuario.
    function validCategory() {
      return !('category' in request.resource.data) ||
        request.resource.data.category in ['STANDARD', 'PREGNANT', 'REDUCED_MOBILITY'];
    }

    // Tipos de aviso que el usuario apagó en la app (`NotificationType`). El backend no le manda
    // pushes de esos tipos (ver functions/notifications.js).
    function validNotificationsDisabled() {
      let data = request.resource.data;
      return !('notificationsDisabled' in data) || (
        data.notificationsDisabled is list &&
        data.notificationsDisabled.hasOnly(['RESERVATION', 'REMINDER', 'ARRIVAL', 'WAITLIST']));
    }

    // Perfil y preferencias. El dueño nunca escribe su rol: lo asigna el backend.
    // Al registrarse puede pedir un rol con `requestedRole`; `ADMIN` no se puede pedir.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && !('role' in request.resource.data) && validCategory() &&
        validNotificationsDisabled() &&
        (!('requestedRole' in request.resource.data) ||
          request.resource.data.requestedRole in ['DRIVER', 'PARKING_ADMIN']);
      allow update: if isOwner(uid) && !changes(['role', 'requestedRole']) && validCategory() &&
        validNotificationsDisabled();

      // Un documento por teléfono donde el usuario tiene la sesión abierta, con su token FCM como id.
      // Las functions mandan los avisos a todos.
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['token', 'updatedAt']) &&
          request.resource.data.token == token;
      }

      // Sus estacionamientos favoritos (T19), con el id del estacionamiento como id. Sólo los ve y
      // los cambia su dueño; la app los guarda también en el teléfono para verlos sin conexión.
      match /favorites/{parkingLotId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['parkingLotId', 'addedAt']) &&
          request.resource.data.parkingLotId == parkingLotId;
      }
    }

    // Estacionamientos. Los crea un administrador de estacionamiento, que queda como su único
    // administrador. Los contadores de lugares los calcula el backend. Hace falta sesión para
    // verlos: la app no muestra nada antes del ingreso.
    match /parkingLots/{lotId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() ||
        (hasRole('PARKING_ADMIN') &&
          request.resource.data.adminUids == [request.auth.uid] &&
          !request.resource.data.keys().hasAny(counterFields()));
      allow delete: if isAdmin() || managesParkingLot(lotId);
      // Su administrador edita los datos, pero no los contadores ni quién lo administra.
      allow update: if isAdmin() ||
        (managesParkingLot(lotId) && !changes(counterFields().concat(['adminUids'])));

      // Lugares del estacionamiento.
      match /spots/{spotId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || managesParkingLot(lotId);
      }
    }

    // Reservas.
    match /reservations/{reservationId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        managesParkingLot(resource.data.parkingLotId);
    }

    // Lista de espera.
    match /waitlist/{entryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Control del simulador de sensores (`config/simulator`: escenario, intervalo y pausa). Es una
    // herramienta de desarrollo: sólo la lee y la escribe un ADMIN. La function que simula usa el
    // Admin SDK y no pasa por estas reglas.
    match /config/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
