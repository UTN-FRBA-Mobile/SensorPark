rules_version = '2';

// Firestore deniega todo lo que no tenga un `allow` explícito: colección nueva = regla nueva.
// Las reglas no son filtros: la query del cliente tiene que llevar el mismo `where` que la regla exige.
// Las Cloud Functions usan el Admin SDK y no pasan por estas reglas: lo que acá no tiene `allow`
// de escritura (reservas, lista de espera, contadores) lo escriben sólo ellas.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // El rol es un custom claim que sólo asigna el backend (functions/index.js).
    function hasRole(role) { return isSignedIn() && request.auth.token.get('role', '') == role; }
    function isAdmin() { return hasRole('ADMIN'); }

    // get() porque se evalúa también desde subcolecciones y desde reservas, donde `resource` es otro documento.
    function managesParkingLot(lotId) {
      return hasRole('PARKING_ADMIN') &&
        request.auth.uid in get(/databases/$(database)/documents/parkingLots/$(lotId)).data.adminUids;
    }

    function changes(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Perfil, token FCM y preferencias. El dueño nunca puede escribir su rol ni su categoría de prioridad.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(['role', 'category']);
      allow update: if isOwner(uid) && !changes(['role', 'category']);
    }

    // Estacionamientos.
    match /parkingLots/{lotId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // Su administrador edita los datos, pero no los contadores ni quién lo administra.
      allow update: if isAdmin() ||
        (managesParkingLot(lotId) && !changes(['adminUids', 'capacity', 'freeSpots', 'freeSpotsByType']));

      // Lugares del estacionamiento.
      match /spots/{spotId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || managesParkingLot(lotId);
      }

      // Cupos por categoría de prioridad de una fecha (id del documento: AAAA-MM-DD).
      match /quotas/{date} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || managesParkingLot(lotId);
      }
    }

    // Reservas.
    match /reservations/{reservationId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        managesParkingLot(resource.data.parkingLotId);
    }

    // Lista de espera.
    match /waitlist/{entryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
