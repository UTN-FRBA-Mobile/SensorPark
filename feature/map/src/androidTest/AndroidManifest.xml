<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:theme="@style/Theme.SensorParkTest">
        <!-- El SDK de Maps se cae si no encuentra la key en el manifiesto. Con una vacía dibuja el
             mapa gris, igual que la app cuando falta MAPS_API_KEY en local.properties. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="" />
    </application>
</manifest>
